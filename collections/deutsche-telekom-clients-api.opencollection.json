              },
              {
                "name": "viewableOnly",
                "value": "",
                "type": "query",
                "description": "filter clients that cannot be viewed in full by admin"
              }
            ]
          },
          "docs": "Get clients belonging to the realm   Returns a list of clients belonging to the realm"
