            "params": [
              {
                "name": "realm",
                "value": "",
                "type": "path",
                "description": "realm name (not id!)"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id of client (not client-id)"
              },
              {
                "name": "attr",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get key info"
        },
        {
